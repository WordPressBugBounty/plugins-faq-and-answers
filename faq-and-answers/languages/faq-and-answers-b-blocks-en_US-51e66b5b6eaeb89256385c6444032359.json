{"translation-revision-date":"YEAR-MO-DA HO:MI+ZONE","generator":"WP-CLI\/2.12.0","source":"build\/blocks\/faq-form\/index.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"en","plural-forms":"nplurals=2; plural=(n != 1);"},"Still Have Questions?":[""],"Submit FAQ":[""],"0 words out of %d":[""],"Colour":[""],"Left":[""],"Right":[""],"Button text":[""],"Text":[""],"Typography":[""],"Heading":[""],"Background":[""],"Typed text":[""],"Placeholder":[""],"Border":[""],"Text on hover":[""],"Label":[""],"Padding":[""],"Copied Successfully!":[""],"Copy To Clipboard":[""],"Copy the shortcode and use it anywhere.":[""],"Card":[""],"Card background":[""],"Card border":[""],"Corner radius":[""],"Centre":[""],"Show heading":[""],"Heading level":[""],"Pick the level that fits the page around it. A page should only carry one H1.":[""],"Show subheading":[""],"Alignment":[""],"Name field":[""],"Show this field":[""],"Required":[""],"Email field":[""],"Without an email you cannot reply to the person who asked.":[""],"Question field":[""],"The question is what the form is for, so it is always shown and always required.":[""],"Word limit":[""],"Set to 0 to hide the counter and drop the limit.":[""],"Detail field":[""],"Suggested answer":[""],"Let visitors answer too":[""],"Adds an optional field so somebody who already knows the answer can send it with the question. It arrives as a draft for you to check.":[""],"Button & confirmation":[""],"Thank you message":[""],"Shown in place of the form once the question has been sent.":[""],"Maximum width":[""],"Shared by the card and the button. The fields have their own, under Fields.":[""],"Behind the card":[""],"Subheading":[""],"Field labels":[""],"Fields":[""],"The preview fields are empty, so this one shows itself on the published page once somebody types.":[""],"Border on hover":[""],"Border when active":[""],"Leave the active colour empty and a focused field keeps using the button colour. A field that fails a check turns red either way.":[""],"Space between fields":[""],"Button":[""],"Also what a focused field is outlined in, unless Fields sets its own active colour.":[""],"Background on hover":[""],"Full width":[""],"Text alignment":[""],"With full width off this moves the button itself, since there is no spare room inside it.":[""],"Submissions arrive under Awesome FAQ \u2192 Form Submissions, where you can read, mark and reply to them.":[""],"Tell people what happens after they send it.":[""]}}}